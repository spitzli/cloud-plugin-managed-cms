{
  "name": "@webdock/cms-instance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "bun --bun next build && bun build-migration.mjs",
    "start": "bun --bun next start",
    "test": "bun test --isolate ./tests/*.test.ts",
    "payload": "bun ../../node_modules/payload/bin.js --disable-transpile",
    "migrate": "bun src/migrate.ts"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "payload": "4.0.0-canary.37",
    "@payloadcms/next": "4.0.0-canary.37",
    "@payloadcms/db-postgres": "4.0.0-canary.37",
    "@payloadcms/storage-s3": "4.0.0-canary.37",
    "sharp": "0.35.5",
    "graphql": "16.14.2",
    "@webdock/cms-ui": "workspace:*",
    "@webdock/cms-bridge": "workspace:*",
    "@webdock/payload-sso": "workspace:*",
    "@webdock/instance-kit": "workspace:*",
    "@webdock/i18n": "workspace:*",
    "@webdock/database-runtime": "workspace:*",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "0.25.12"
  }
}
