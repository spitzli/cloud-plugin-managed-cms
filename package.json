{
  "name": "webdock-extension-managed-cms",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "extensions/managed-cms",
    "apps/cms-instance",
    "packages/plugin-sdk",
    "packages/cms-ui",
    "packages/cms-bridge",
    "packages/payload-sso",
    "packages/oauth-session",
    "packages/instance-kit",
    "packages/i18n",
    "packages/database-runtime"
  ],
  "scripts": {
    "build:sdk": "bun run --filter @webdock/plugin-sdk build",
    "build:plugin": "bun run build:sdk && bun extensions/managed-cms/build.ts",
    "build:instance": "bun run --filter @webdock/cms-instance build",
    "build": "bun run build:plugin && bun run build:instance",
    "check": "bun run build:sdk && bun run --filter @webdock/extension-managed-cms check",
    "test": "bun run build:sdk && bun test --isolate ./extensions/managed-cms/tests ./apps/cms-instance/tests ./packages/cms-bridge/src ./packages/cms-ui/src ./scripts/finalize.test.mjs"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/bun": "^1.3.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/pg": "^8.15.5",
    "happy-dom": "20.14.5"
  },
  "overrides": {
    "nodemailer": "10.0.13",
    "dompurify": "3.4.16"
  },
  "patchedDependencies": {
    "drizzle-orm@0.45.2": "patches/drizzle-orm@0.45.2.patch",
    "@payloadcms/storage-s3@4.0.0-canary.37": "patches/@payloadcms%2Fstorage-s3@4.0.0-canary.37.patch",
    "@payloadcms/plugin-cloud-storage@4.0.0-canary.37": "patches/@payloadcms%2Fplugin-cloud-storage@4.0.0-canary.37.patch"
  },
  "license": "AGPL-3.0-only"
}
