msgstr "Bereitstellung fehlgeschlagen"


msgid "Rollout operation"
msgstr "Bereitstellung ansehen"


msgid "Save build settings"
msgstr "Build-Einstellungen speichern"


msgid "Selected build"
msgstr "Ausgewählter Build"


msgid "Superseded"
msgstr "Ersetzt"


msgid "The log cursor moved backwards."
msgstr "Die Protokollposition ist zurückgesprungen."


msgid "The log event cursor is invalid."
msgstr "Die Position des Protokollereignisses ist ungültig."


msgid "The source changed before this build completed."
msgstr "Die Quelle wurde geändert, bevor dieser Build abgeschlossen war."


msgid "The source changed. Reload its settings before saving."
msgstr "Die Quelle wurde geändert. Lade ihre Einstellungen vor dem Speichern neu."


msgid "This source uses an external build provider."
msgstr "Diese Quelle verwendet einen externen Build-Anbieter."


msgid "{project} builds"
msgstr "Builds für {project}"


msgid "Attempt"
msgstr "Versuch"


msgid "Not started"
msgstr "Noch nicht gestartet"


msgid "Retries"
msgstr "Wiederholungen"


msgid "{count} of 2"
msgstr "{count} von 2"


msgid "Finished"
msgstr "Abgeschlossen"


msgid "Request to completion"
msgstr "Von Anfrage bis Abschluss"


msgid "{seconds} s"
msgstr "{seconds} s"


msgid "Eligible for retry after {date}"
msgstr "Erneuter Versuch frühestens ab {date}"


msgid "Previous build environment issue: {reason}"
msgstr "Vorheriges Problem der Build-Umgebung: {reason}"


msgid "The build exceeded its time limit."
msgstr "Der Build hat sein Zeitlimit überschritten."


msgid "The build exceeded its memory limit."
msgstr "Der Build hat sein Arbeitsspeicherlimit überschritten."


msgid "The build environment ran out of resources."
msgstr "In der Build-Umgebung waren nicht genügend Ressourcen verfügbar."


msgid "The build node is temporarily unavailable."
msgstr "Der Build-Knoten ist vorübergehend nicht erreichbar."


msgid "The build service is temporarily unavailable."
msgstr "Der Build-Dienst ist vorübergehend nicht erreichbar."


msgid "The build failed. Review the retained logs."
msgstr "Der Build ist fehlgeschlagen. Prüfe die gespeicherten Protokolle."


msgid "Build after GitHub workflow succeeds"
msgstr "Builds nach erfolgreichem GitHub-Workflow starten"


msgid "Only successful push runs of {workflow} may start automatic builds. Publication approval remains separate."
msgstr "Nur erfolgreiche, durch Push ausgelöste Läufe von {workflow} dürfen automatische Builds starten. Die Freigabe zur Veröffentlichung bleibt davon getrennt."
