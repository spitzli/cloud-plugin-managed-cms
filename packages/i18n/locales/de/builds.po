msgstr "Es wird nur die neueste Protokollausgabe angezeigt."


msgid "Phase: {phase}"
msgstr "Phase: {phase}"


msgid "Preparing"
msgstr "Wird vorbereitet"


msgid "Preparing build environment"
msgstr "Build-Umgebung wird vorbereitet"


msgid "Publication queued"
msgstr "Veröffentlichung eingeplant"


msgid "Publications"
msgstr "Veröffentlichungen"


msgid "Pushing"
msgstr "Wird übertragen"


msgid "Railpack"
msgstr "Railpack"


msgid "Recording request…"
msgstr "Anfrage wird erfasst…"


msgid "Redeploy this version"
msgstr "Diese Version erneut bereitstellen"


msgid "Reload settings"
msgstr "Einstellungen neu laden"


